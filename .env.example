# Runtime
E2E_BASE_URL=https://v2dev.skilledup.life
HEADED=false

# Company registration test data. {timestamp} is replaced for each test run.
RUN_ACCOUNT_CREATION=false
E2E_COMPANY_USERNAME=e2e-company-{timestamp}
E2E_COMPANY_EMAIL=e2e-company+{timestamp}@your-test-mail-domain.example
E2E_COMPANY_PASSWORD=replace-with-a-dedicated-test-password
E2E_COMPANY_FIRST_NAME=E2E
E2E_COMPANY_LAST_NAME=Regression
E2E_COMPANY_NAME=E2E Regression {timestamp}
E2E_COMPANY_COUNTRY=Albania
E2E_COMPANY_CATEGORY=AdTech

# Authenticated company state and routes. Uncomment after creating the state.
# E2E_STORAGE_STATE=playwright/.auth/company.json
# E2E_COMPANY_PRICING_URL=https://test-host/company/pricing
# E2E_COMPANY_DASHBOARD_URL=https://test-host/company/dashboard

# Stripe Sandbox only. Never put a real card in this file.
RUN_STRIPE_SANDBOX=false
E2E_STRIPE_CARD=4242424242424242
E2E_STRIPE_EXPIRY=1229
E2E_STRIPE_CVC=123
E2E_STRIPE_CARDHOLDER=E2E Regression
E2E_STRIPE_COUNTRY=New Zealand

# Company Profile Basic Info mutation. Keep false for normal regression runs.
RUN_COMPANY_PROFILE_UPDATE=false
E2E_PROFILE_COMPANY_NAME=E2E Regression Company
E2E_PROFILE_CITY=Auckland
E2E_PROFILE_MOBILE_NUMBER=210000000
E2E_PROFILE_WEBSITE=https://example.com
E2E_PROFILE_YOUTUBE_PITCH=https://www.youtube.com/watch?v=test

# Company Profile Social Media
E2E_PROFILE_SOCIAL_PLATFORM=LinkedIn
E2E_PROFILE_SOCIAL_URL=https://www.linkedin.com/company/e2e-regression

# Company Profile Company Background
E2E_PROFILE_COMPANY_STAGE=Idea Stage
E2E_PROFILE_TEAM_SIZE=Less than 5 people
E2E_PROFILE_TEAM_STRUCTURE=Our dedicated test company has a small cross-functional team covering product discovery, engineering, design, quality assurance, customer research, and delivery. Responsibilities are explicit, decisions are documented, progress is reviewed every week, and skill gaps are recorded before volunteers are recruited for focused, measurable assignments.
E2E_PROFILE_FUNDING_SOURCE=Personal Savings
E2E_PROFILE_DISCOVERY_SOURCE=Email Campaign

# Company Profile Business Background; every description must be 300+ characters.
E2E_PROFILE_BUSINESS_DESCRIPTION=Our dedicated test company develops workflow software that helps small organisations organise recurring work, record ownership, review progress, and collaborate with skilled volunteers. The product is validated through structured customer interviews, measurable experiments, accessibility checks, and frequent delivery of small improvements based on observed user needs.
E2E_PROFILE_PROGRESS_DESCRIPTION=The test company has completed initial customer discovery, mapped the core workflow, produced a working prototype, and collected structured feedback from early users. The team now reviews adoption, completion rates, support requests, and usability findings so that each delivery cycle addresses a verified problem and produces an outcome that can be measured.
E2E_PROFILE_NEXT_18_MONTHS_PLAN=During the next twelve to eighteen months the test company plans to strengthen product reliability, improve onboarding, expand customer research, document operational processes, and recruit volunteers for clearly scoped roles. Progress will be assessed against delivery milestones, user retention, service quality, accessibility, and evidence that the product solves a repeatable customer problem.
